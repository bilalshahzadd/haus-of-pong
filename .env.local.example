# Figma personal access token used only for re-syncing design tokens/assets.
# Never commit the real value.
FIGMA_TOKEN=
FIGMA_FILE_KEY=Tge0IcB0cHdH96SE0l4Dm6

# ── HubSpot ───────────────────────────────────────────────────────────────
# Fill in ONE of the two blocks below. Option A is preferred and needs no
# secret; the route falls back to B only when A is absent.

# A. Forms API — both values are public identifiers, not credentials.
#    Portal ID : app.hubspot.com/contacts/<THIS NUMBER>/...
#    Form GUID : Marketing > Forms > your form > Share > embed code `formId`
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# B. Private app token — a real secret. Server-side only; adding a
#    NEXT_PUBLIC_ prefix would ship it to every visitor's browser.
#    Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#            crm.objects.notes.write
HUBSPOT_PRIVATE_APP_TOKEN=
